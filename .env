# Umgebungsvariablen für Chipilito
# Kopieren nach ".env" und Werte nach Bedarf anpassen: cp .env.example .env

# KI-Provider wählen: ollama, gemini oder openai_compatible
CHATLITE_PROVIDER=ollama

# --- Ollama (lokal) ---
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma2
OLLAMA_NUM_CTX=21586

# --- Google Gemini (Cloud) ---
# Nur nötig, wenn CHATLITE_PROVIDER=gemini
# GEMINI_API_KEY=dein_api_key_von_google_cloud
# GEMINI_MODEL=gemini-2.0-flash

# --- Generischer OpenAI-kompatibler Anbieter ---
# Nur nötig, wenn CHATLITE_PROVIDER=openai_compatible
# OPENAI_COMPATIBLE_URL=https://openrouter.ai/api/v1
# OPENAI_COMPATIBLE_API_KEY=dein_api_key
# OPENAI_COMPATIBLE_MODEL=anthropic/claude-3.5-haiku

# Server-Port (optional, standardmäßig 3000)
PORT=3000

# Pfad zur SQLite-Datenbankdatei (optional, praktisch für Docker-Volumes)
DB_PATH=./chipilito.db

# Maximalgröße für Dateiuploads in Bytes (5MB)
MAX_FILE_SIZE=5242880
